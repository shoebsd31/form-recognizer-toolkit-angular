# --------------------------------------------------------------------------
# Sample environment configuration. Copy this file to `.env` and fill in the
# values. `.env` is git-ignored — never commit real keys.
#
#   cp sample.env .env
# --------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Allowed CORS origin for the Angular client (optional).
# SITE_URL=http://localhost:4200

# --- Azure AI Content Understanding ---------------------------------------
# Your Content Understanding (Microsoft Foundry) resource endpoint, e.g.
#   https://<your-resource>.services.ai.azure.com
CU_ENDPOINT=
# Subscription key for the resource (sent as the Ocp-Apim-Subscription-Key header).
CU_API_KEY=
# REST API version. GA is 2025-11-01.
CU_API_VERSION=2025-11-01
# Default analyzer id used by /cu/analyze when ?analyzerId= is not supplied.
CU_ANALYZER_ID=
# Folder where <filename>.result.json files are written. Defaults to Server/data.
CU_RESULTS_DIR=Server/data
# Folder files are read from when analyzing/testing by name. Defaults to Server/data.
CU_DATA_DIR=Server/data
# Folder where /cu/labels?studio=true writes the GUID-named trio for CU Studio.
# Defaults to <CU_RESULTS_DIR>/studio.
CU_STUDIO_DIR=Server/data/studio
# Optional: default analyzer-definition JSON used by /train when no body is posted.
# CU_ANALYZER_DEFINITION_FILE=cuf storage/analyzer.json

# --- Polling / limits (optional) ------------------------------------------
# How often to poll async CU operations, and how long before giving up.
CU_POLL_INTERVAL_MS=2000
CU_POLL_TIMEOUT_MS=300000
# Max upload size for the analyze/test endpoints.
CU_MAX_UPLOAD=100mb
